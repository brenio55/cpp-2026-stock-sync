# Copy to .env and adjust. Development defaults only; never reuse these secrets elsewhere.

# --- infrastructure (docker compose) ---
POSTGRES_USER=stocksync
POSTGRES_PASSWORD=stocksync
POSTGRES_DB=stocksync
POSTGRES_PORT=5433
RABBITMQ_USER=stocksync
RABBITMQ_PASSWORD=stocksync
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- api / worker ---
DATABASE_URL=postgres://stocksync:stocksync@localhost:5433/stocksync
RABBITMQ_URL=amqp://stocksync:stocksync@localhost:5672
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
PORT=3000
LOG_LEVEL=info

# --- sync (used from phase 5) ---
ADS_API_URL=http://localhost:4000
ADS_TIMEOUT_MS=3000
SYNC_BATCH_SIZE=50
SYNC_MAX_ATTEMPTS=5
SYNC_RATE_LIMIT_RPS=5
